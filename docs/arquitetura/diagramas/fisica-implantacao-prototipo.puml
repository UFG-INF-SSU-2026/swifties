@startuml fisica-implantacao-prototipo
!include _estilo.iuml
title Visão física — Implantação do protótipo (como construído)

cloud "Wokwi (simulador na nuvem)" as Wokwi {
  node "ESP32 virtual\n<<device>>" as Esp {
    artifact "main.py · sensores.py · evento.py\n(MicroPython)" as EspArt
    node "MPU6050 (I²C 21/22)\nDS18B20 ×2 (18, 19)\nLED RGB (25/26/27)\nBotão (4)" as Hw <<periféricos>>
  }
  node "Rede Wokwi-GUEST\n<<Wi-Fi>>" as Wifi
}

cloud "Internet" as Net {
  node "pool.ntp.org\n<<NTP>>" as Ntp
  node "ngrok edge\n0.tcp.sa.ngrok.io:<porta>\n<<TCP>>" as NgEdge
  node "CDN\nunpkg · cdnjs" as Cdn
}

node "Máquina local (Docker Desktop / WSL2)\n<<execution environment>>" as Host {
  node "container ngrok\n(painel :4040)" as NgAgent
  node "container mosquitto\neclipse-mosquitto:2" as Mosq {
    artifact "mosquitto.conf · acl · passwd" as MosqArt
  }
  node "container consumidor\npython:3.12-slim" as Cons {
    artifact "consumidor/main.py" as ConsArt
  }
  node "container dashboard-front\nnginx:alpine" as Nginx {
    artifact "dashboard/ (estático)" as DashArt
  }
}

node "Navegador do usuário" as Browser {
  artifact "index.html + app.js\n(MQTT.js, Chart.js)" as BrArt
}

Esp -- Wifi
Wifi -- Ntp : UDP 123
Wifi -- NgEdge : MQTT/TCP\n(sem TLS)
NgEdge -- NgAgent : túnel TLS do ngrok
NgAgent -- Mosq : TCP 1883\n(rede Docker)
Cons -- Mosq : MQTT 1883\nhost.docker.internal
Browser -- Nginx : HTTP 8080
Browser -- Mosq : MQTT/WebSocket\nws://localhost:9001
Browser -- Cdn : HTTPS

note bottom of Mosq
  Portas publicadas no host:
  1883 (MQTT), 9001 (WS).
  allow_anonymous false + ACL.
end note
@enduml
