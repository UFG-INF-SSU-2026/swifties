@startuml logica-estados-no
!include _estilo.iuml
title Visão lógica — Estados do nó: operação da máquina e enlace

state "Estado operacional (EstadoOperacao, a cada janela de 5 s)" as Op {
  state DESCONHECIDO
  state LIGADA #D1FAE5
  state DESLIGADA #E5E7EB

  [*] --> DESCONHECIDO
  DESCONHECIDO --> LIGADA : RMS ≥ 0,20 g\npor 2 janelas
  DESCONHECIDO --> DESLIGADA : RMS < 0,10 g\npor 2 janelas
  LIGADA --> DESLIGADA : RMS < 0,10 g\npor 2 janelas\n/ emite mudanca_operacao
  DESLIGADA --> LIGADA : RMS ≥ 0,20 g\npor 2 janelas\n/ emite mudanca_operacao

  note right of LIGADA
    0,10 g ≤ RMS < 0,20 g:
    histerese, mantém o estado.
    Só janelas válidas contam.
  end note
}

state "Enlace (Emissor.estado_link, a cada 50 ms) — cor do LED" as Link {
  state EM_DIA #D1FAE5 : LED verde\nbuffer vazio
  state PENDENTE #FEF3C7 : LED amarelo\ndrenando buffer
  state OFFLINE #FEE2E2 : LED vermelho\nsem conexão MQTT
  state BUFFER_CHEIO #FEE2E2 : LED vermelho\n100 eventos; descarta o mais antigo

  [*] --> OFFLINE : boot (LED azul)
  OFFLINE --> PENDENTE : reconectou\n(tentativa a cada 5 s)
  PENDENTE --> EM_DIA : último PUBACK
  EM_DIA --> PENDENTE : novo evento criado
  EM_DIA --> OFFLINE : queda / botão\n(broker publica OFFLINE)
  PENDENTE --> OFFLINE : envio falhou\nou queda
  OFFLINE --> BUFFER_CHEIO : buffer atinge 100
  BUFFER_CHEIO --> PENDENTE : reconectou

  note bottom of OFFLINE
    Leitura inválida recente sobrepõe
    a cor com magenta (exceto em
    OFFLINE / BUFFER_CHEIO).
  end note
}
@enduml
