@startuml processo-atividade-hub-avaliacao
!include _estilo.iuml
title Visão de processo — Hub: ciclo de avaliação\n(consumidor/main.py · ciclo/avaliar, thread principal a cada 2 s)

start
repeat :para cada Ativo;
  :poda vib/temp com eventTime < agora − 30 s;
  if (agora − ultimoEvento > 15 s?) then (sim)
    :SEM_COMUNICACAO;
  elseif (vib < 3 ou temp < 3?) then (sim)
    :DADOS_INSUFICIENTES;
  elseif (estadoOperacional = DESLIGADA?) then (sim)
    :NAO_AVALIAVEL;
  else
    :rms = mediana(RMS); curtoseMax = máx(curtose)\nΔT = média das 3 últimas temperaturas;
    if (linha de base existe?) then (não)
      :linha de base = (rms, ΔT);
      :NORMAL;
    else
      :rmsNorm = rms / base.rms\nexcedentes = #(RMS > 1,5 × base.rms);
      if (rmsNorm ≥ 2 e (curtoseMax ≥ 6 ou ΔT ≥ base + 20)?) then (sim)
        #FEE2E2:CRITICO;
      elseif (excedentes ≥ 80 % ou ΔT ≥ base + 10?) then (sim)
        #FEF3C7:ATENCAO;
      else
        #D1FAE5:NORMAL;
      endif
    endif
  endif
  :PUBLISH consumidor/<entityId>/decisao\n(QoS 1, retido, com métricas);
  if (decisão mudou?) then (sim)
    :log [DECISAO];
  endif
repeat while (há mais ativos?)
stop
@enduml
