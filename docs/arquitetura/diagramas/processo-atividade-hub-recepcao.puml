@startuml processo-atividade-hub-recepcao
!include _estilo.iuml
title Visão de processo — Hub: recepção de eventos\n(consumidor/main.py · ao_receber, thread de rede do paho)

start
:mensagem em swifties/#;
if (tópico termina em /status?) then (sim)
  :registra ONLINE / OFFLINE;
  stop
endif
if (JSON válido?) then (não)
  :log de aviso;
  stop
endif
:obtém ou cria Ativo(entityId);
if (eventId ∈ vistos?) then (sim)
  :descarta (duplicata QoS 1);
  stop
endif
:vistos += eventId\nultimoEvento = agora;
if (eventType = maquina.mudanca_operacao?) then (sim)
  :estadoOperacional = data.estado;
  stop
endif
if (quality = VALIDO?) then (não)
  :log [INVALIDO] motivo;
  stop
endif
:anexa (eventTime, data) à lista\nvib ou temp do Ativo;
stop

@enduml
