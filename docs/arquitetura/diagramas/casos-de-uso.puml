@startuml casos-de-uso
!include _estilo.iuml
title Cenários (+1) — Casos de uso
left to right direction

actor "Técnico de\nmanutenção" as Tecnico
actor "Planejador / PCM" as PCM
actor "Gestor" as Gestor
actor "Infraestrutura" as Infra
actor "Desenvolvedor" as Dev
actor "Ativo\n(máquina rotativa)" as Ativo <<físico>>

rectangle "Sistema de manutenção preditiva" {
  usecase "UC-01 Monitorar vibração\ne temperatura" as UC01
  usecase "UC-02 Detectar máquina\nligada / desligada" as UC02
  usecase "UC-03 Classificar saúde\ndo ativo" as UC03
  usecase "UC-04 Acompanhar estado\nem tempo real" as UC04
  usecase "UC-05 Analisar tendência\ne histórico de estados" as UC05
  usecase "UC-06 Sinalizar estado\nno LED do nó" as UC06
  usecase "UC-07 Tolerar queda\nde enlace" as UC07
  usecase "UC-08 Detectar nó\nsilencioso" as UC08
  usecase "UC-09 Rejeitar leitura\ninválida" as UC09
  usecase "UC-10 Simular cenários\nsem hardware" as UC10
}

Ativo --> UC01
UC01 ..> UC09 : <<include>>
UC01 ..> UC02 : <<include>>
UC03 ..> UC01 : <<include>>
UC07 ..> UC01 : <<extend>>

Tecnico --> UC04
Tecnico --> UC06
PCM --> UC05
Gestor --> UC04
Infra --> UC08
Infra --> UC06
Dev --> UC10

UC04 ..> UC03 : <<include>>
UC05 ..> UC03 : <<include>>
UC08 ..> UC03 : <<extend>>
UC10 ..> UC03 : <<include>>
@enduml
