@startuml desenvolvimento-componentes
!include _estilo.iuml
title Visão de desenvolvimento — Módulos do repositório e interfaces
left to right direction

package "publisher/  (MicroPython · ESP32)" as PPub {
  component "main.py\nconfiguração, laço, LED,\nbotão, EstadoOperacao" as PMain
  component "sensores.py\nMPU6050, Termometro,\nindicadores, validação" as PSens
  component "evento.py\nEmissor (contrato v1, buffer),\nConexaoMQTT\n— usa umqtt.simple" as PEv
  file "diagram.json\n(circuito Wokwi)" as PDiag
  PMain --> PSens : coletar_janela()\ncalcular_indicadores()\nvalidar_*()
  PMain --> PEv : Emissor.criar()\nenviar_um()
}

package "broker/  (configuração Docker)" as PBrk {
  component "mosquitto.conf\nlisteners 1883 / 9001" as BConf
  file "acl" as BAcl
  file "passwd" as BPw
  component "docker-compose.yml\nmosquitto + ngrok" as BComp
  BConf --> BAcl
  BConf --> BPw
  rectangle "<<tópico MQTT>>\nswifties/<deviceId>/#\ncontrato de evento v1" as IEv #FEF3C7
  rectangle "<<tópico MQTT>>\nconsumidor/<entityId>/decisao\npayload de decisão" as IDec #FEF3C7
}

package "consumidor/  (Python 3.12)" as PCons {
  component "main.py\nAtivo, ao_receber, avaliar, ciclo\n— usa paho-mqtt 2.x" as CMain
  component "ferramentas/mock_publisher.py\ncenários sintéticos\n— usa paho-mqtt 2.x" as CMock
  file "Dockerfile\nrequirements.txt" as CDock
}

package "dashboard/  (HTML/CSS/JS estático)" as PDash {
  component "js/app.js\nconexão WS, renderização,\ngráfico, histórico\n— usa MQTT.js 5, Chart.js 4 (CDN)" as DApp
  component "js/config.js\nbroker, tópico, DECISAO_META" as DCfg
  file "index.html\ncss/styles.css" as DHtml
  DApp --> DCfg
  DHtml --> DApp
}


PEv --> IEv : publica
CMock --> IEv : publica
CMain --> IEv : assina
CMain --> IDec : publica
DApp --> IDec : assina (WS)

@enduml
