@startuml casos-de-uso
!include _estilo.iuml
title Casos de uso
left to right direction

actor "Técnico de\nmanutenção" as Tecnico
actor "PCM / Gestor" as PCM
actor "Ativo\n(máquina)" as Ativo

rectangle "Sistema de manutenção preditiva" {
  usecase "Medir vibração\ne temperatura" as UC1
  usecase "Classificar saúde\ndo ativo" as UC2
  usecase "Acompanhar estado\nem tempo real" as UC3
  usecase "Analisar tendência\ne histórico" as UC4
  usecase "Alertar perda de\ncomunicação" as UC5
}

Ativo --> UC1
UC2 ..> UC1 : <<include>>
Tecnico --> UC3
Tecnico --> UC5
PCM --> UC4
UC3 ..> UC2 : <<include>>
UC4 ..> UC2 : <<include>>
@enduml
