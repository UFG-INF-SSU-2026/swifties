@startuml processo
!include _estilo.iuml
title Visão de processo — Da medição às interfaces

participant "Nó ESP32" as No
participant "Broker\nMosquitto" as Broker
participant "Consumidor\n(hub)" as Hub
participant "Dashboard\nweb" as Dash
participant "App\nmobile" as App

loop a cada 2 s (temperatura) / 5 s (vibração)
  No -> No : mede, calcula indicadores\ne guarda evento no buffer
  No -> Broker : publica evento (QoS 1)
  Broker --> No : confirmação (PUBACK)
  Broker -> Hub : evento
  Hub -> Hub : descarta duplicata\ne adiciona à janela
end

loop a cada 2 s
  Hub -> Hub : aplica regra sobre a janela\n→ NORMAL / ATENCAO / CRITICO
  Hub -> Broker : publica decisão
  Broker -> Dash : decisão
  Broker -> App : decisão
  Dash -> Dash : atualiza card e gráfico
  App -> App : atualiza card;\nvibra se CRITICO
end

group Queda de enlace
  No -x Broker : conexão perdida
  No -> No : continua medindo,\nacumula eventos no buffer
  Hub -> Dash : SEM_COMUNICACAO\n(via broker, após 15 s)
  No -> Broker : reconecta e reenvia o buffer
end
@enduml
