@startuml desenvolvimento
!include _estilo.iuml
title Visão de desenvolvimento — Componentes do repositório
left to right direction

package "publisher/  (MicroPython)" {
  component "main.py\nlaço principal" as PMain
  component "sensores.py\nleitura e indicadores" as PSens
  component "evento.py\ncontrato, buffer, MQTT" as PEv
  PMain --> PSens
  PMain --> PEv
}

package "broker/  (Mosquitto + ngrok)" {
  rectangle "swifties/<deviceId>/...\neventos" as T1 #FEF3C7
  rectangle "consumidor/<entityId>/decisao\ndecisões" as T2 #FEF3C7
}

package "consumidor/  (Python)" {
  component "main.py\njanela e regra de decisão" as CMain
}

package "dashboard/  (HTML/JS)" {
  component "app.js\nvisualização" as DApp
}

package "mobile/  (React Native / Expo)" {
  component "useMqtt.ts\nconexão e alertas" as MApp
  component "App.tsx\ntelas de ativos e ajustes" as MUi
  MUi --> MApp
}

PEv --> T1 : publica
CMain --> T1 : assina
CMain --> T2 : publica
DApp --> T2 : assina
MApp --> T2 : assina
@enduml
